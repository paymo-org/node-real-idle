{
  "name": "@paymoapp/real-idle",
  "version": "1.2.0",
  "type": "module",
  "description": "Detect if the system is really idle or the user is just watching a video",
  "main": "./dist/index.cjs",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "demo": "electron demo/electron.mjs --no-sandbox",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "typecheck": "tsc --noEmit",
    "clean": "hereby clean",
    "build": "hereby build",
    "build:ts": "hereby build:ts",
    "prebuildify": "hereby prebuildify",
    "generate:readme-toc": "markdown-toc -i --bullets=\"-\" --maxdepth=4 README.md",
    "release": "commit-and-tag-version",
    "release:pre": "commit-and-tag-version --prerelease"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/",
    "prebuilds/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/paymo-org/node-real-idle"
  },
  "keywords": [
    "node",
    "addon",
    "idle",
    "system idle",
    "power requests"
  ],
  "author": "Paymo LLC",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "commit-and-tag-version": "^13.1.2",
    "electron": "^44.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "execa": "^10.0.1",
    "hereby": "^1.15.2",
    "markdown-toc": "^1.2.0",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^13.0.2",
    "prebuildify": "^6.0.1",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "node-gyp-build": "^4.8.4"
  }
}
